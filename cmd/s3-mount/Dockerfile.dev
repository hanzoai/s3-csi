# S3_COMMIT should match the commit in go.mod for reproducibility
# Update via: docker build --build-arg S3_COMMIT=<hash> ...
ARG S3_COMMIT=19ce7c0b6fdb

FROM golang:1.25-alpine AS builder

RUN apk add git g++

# Build s3 binary from a specific commit for reproducibility
ARG S3_COMMIT
RUN git clone https://github.com/s3/s3 /go/src/github.com/s3/s3 \
    && cd /go/src/github.com/s3/s3 \
    && git checkout ${S3_COMMIT} \
    && cd s3 \
    && go install

# Build s3-mount from current context
WORKDIR /go/src/github.com/s3/s3-csi-driver
COPY . .

RUN go build -ldflags="-s -w" -o /s3-mount ./cmd/s3-mount/main.go

FROM alpine AS final
RUN apk add fuse
COPY --from=builder /go/bin/s3 /usr/bin/
COPY --from=builder /s3-mount /

RUN chmod +x /s3-mount
ENTRYPOINT ["/s3-mount"]
